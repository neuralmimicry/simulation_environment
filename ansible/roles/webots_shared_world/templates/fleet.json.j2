{
  "api_base": {{ simulation_environment_webots_api_base | to_json }},
  "activity_addr": {{ simulation_environment_webots_activity_addr | to_json }},
  "access_token_file": {{ simulation_environment_webots_access_token_file | to_json }},
  "input_spike_threshold": {{ simulation_environment_webots_input_spike_threshold | float }},
  "inference_interval_ms": {{ simulation_environment_webots_inference_interval_ms | int }},
  "output_hold_ms": {{ simulation_environment_webots_output_hold_ms | int }},
  "robots": {
{% for robot_name, binding in (simulation_environment_webots_network_bindings | dictsort) %}
    {{ robot_name | to_json }}: {
      "network_id": {{ binding.network_id | default('') | to_json }},
      "node_id": {{ binding.node_id | default('') | to_json }},
      "sensor_regex": {{ binding.sensor_regex | default('^celegans_s_.*$') | to_json }},
      "actuator_regex": {{ binding.actuator_regex | default('^celegans_o_.*$') | to_json }},
      "expected_sensory": {{ binding.expected_sensory | default(24) | int }},
      "expected_outputs": {{ binding.expected_outputs | default(96) | int }}
    }{{ "," if not loop.last else "" }}
{% endfor %}
  }
}
